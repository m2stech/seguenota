# Segue Nota — variáveis de ambiente
# Nunca versionar segredos reais. Copiar para .env.local (apps/web) e preencher.
# Ver CLAUDE.md e docs/PRD.md (§17, §21) para contexto de cada pendência (P-xx).

# --- Site / domínio (pendência P3: domínio oficial ainda não definido) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Projeto Supabase novo, separado do legado (D11). Nunca reaproveitar credenciais do legado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: apenas no servidor (Route Handlers/Server Actions), nunca exposta ao cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string direta (migrations, scripts administrativos via Supabase CLI).
SUPABASE_DB_URL=

# --- Stripe (Milestone 15) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- E-mail transacional (pendência P4: provedor a definir, ex. Resend) ---
# Abstraído detrás de uma interface de envio — nunca acoplar código ao provedor escolhido.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Segue Nota <no-reply@example.com>"

# --- Observabilidade (Sentry ou equivalente) ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Fila assíncrona (pendência P5: Vercel Queues/Workflow vs Supabase pgmq+Cron) ---
# Preencher conforme a decisão tomada; ponto de configuração explícito, nunca hardcoded.
QUEUE_PROVIDER=

# --- Agente ↔ Backend (Milestone 9) ---
# Intervalo padrão de sincronização em minutos (pendência P7 — configurável, padrão 60).
AGENT_SYNC_INTERVAL_MINUTES=60
